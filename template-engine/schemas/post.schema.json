{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MIROR_Post_Schema",
  "description": "Formal JSON Schema for MIROR T01 Text Carousel Payload",
  "type": "object",
  "required": ["content_id", "template_id", "canvas", "slides"],
  "properties": {
    "content_id": { "type": "string" },
    "template_id": { "type": "string" },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "aspect_ratio": { "type": "string" }
      }
    },
    "slides": {
      "type": "array"
    }
  }
}
