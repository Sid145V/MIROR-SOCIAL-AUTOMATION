    {
      "content_id": "MIROR-SUP-019",
      "template_id": "T01",
      "content_title": "THE SYMPTOM → INGREDIENT CHEAT SHEET",
      "objective": null,
      "type": null,
      "source": "Miror AI Posts - Supplements_30_Posts_Design_Handoff.docx",
