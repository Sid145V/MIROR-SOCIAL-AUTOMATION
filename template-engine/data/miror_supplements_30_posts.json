          "id": "S03",
          "type": "cta",
          "headline": {
            "text": "DON'T BUY THE PROMISE.",
            "lock": "EXACT"
          },
          "body": [
            {
              "text": "UNDERSTAND THE INGREDIENT.",
              "lock": "EXACT"
            }
          ],
          "cta": {
            "text": "VISIT MIROR →\nLink in bio",
            "lock": "EXACT"
          }
        }
