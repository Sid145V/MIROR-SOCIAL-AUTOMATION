        {
          "id": "S01",
          "type": "hook",
          "headline": {
            "text": "YOU TAKE:\n\nA PRESCRIPTION.\nA MULTIVITAMIN.\nMAGNESIUM.\nOMEGA-3.\nA HERBAL BLEND.\n\nAND NEVER TELL YOUR DOCTOR.",
