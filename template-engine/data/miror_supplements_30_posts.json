      "source": "Miror AI Posts - Supplements_30_Posts_Design_Handoff.docx",
      "slides": [
        {
          "id": "S01",
          "type": "hook",
          "headline": {
            "text": "YOUR SUPPLEMENT LABEL SAYS:\n\n500%.\n1000%.\n2000%.\n\nSO IT MUST BE BETTER…\n\nRIGHT?",
            "lock": "EXACT"
          }
        },
        {
          "id": "S02",
          "type": "follow-through",
          "headline": {
            "text": "NO.",
            "lock": "EXACT"
          },
          "body": [
            {
              "text": "Some nutrients have upper limits, interactions or risks at high doses.",
              "lock": "EXACT"
            },
            {
              "text": "Water-soluble doesn't mean “impossible to overdose.”",
              "lock": "EXACT"
            },
            {
              "text": "And some nutrients simply don't provide extra benefit just because you take more.",
              "lock": "EXACT"
            },
            {
              "text": "DOSE MATTERS.",
              "lock": "EXACT"
            }
          ]
        },
        {
          "id": "S03",
          "type": "cta",
          "headline": {
            "text": "SMART SUPPLEMENTATION STARTS WITH THE RIGHT DOSE.",
            "lock": "EXACT"
          },
