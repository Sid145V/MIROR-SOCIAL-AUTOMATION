    {
      "content_id": "MIROR-SUP-020",
      "template_id": "T01",
      "content_title": "PERIMENOPAUSE IS NOT A DEFICIENCY",
      "objective": null,
      "type": null,
      "source": "Miror AI Posts - Supplements_30_Posts_Design_Handoff.docx",
      "slides": [
        {
          "id": "S01",
          "type": "hook",
          "headline": {
            "text": "PERIMENOPAUSE DOESN'T MEAN:\n\n“MY BODY NEEDS MORE OF EVERYTHING.”",
            "lock": "EXACT"
          }
        },
        {
          "id": "S02",
          "type": "follow-through",
          "headline": {
            "text": "HERE'S THE IMPORTANT PART.",
            "lock": "EXACT"
          },
          "body": [
            {
              "text": "Hormonal changes are not automatically caused by vitamin or mineral deficiencies.",
              "lock": "EXACT"
            },
            {
              "text": "Supplements can support nutritional needs.",
              "lock": "EXACT"
            },
            {
              "text": "THEY DON'T REPLACE HORMONAL CARE.",
              "lock": "EXACT"
            },
            {
              "text": "Know the difference between supporting your body and trying to “balance” hormones with a capsule.",
              "lock": "EXACT"
            }
          ]
        },
        {
          "id": "S03",
          "type": "cta",
          "headline": {
            "text": "DON'T CONFUSE NUTRITION WITH HORMONE TREATMENT.",
            "lock": "EXACT"
          },
          "cta": {
            "text": "VISIT MIROR →\nLink in bio",
            "lock": "EXACT"
          }
        }
      ]
    },
