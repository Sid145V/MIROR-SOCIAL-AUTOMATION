          "body": [
            {
              "text": "TIRED → check sleep, diet and possible nutrient deficiencies.",
              "lock": "EXACT"
            },
            {
              "text": "BONE CONCERNS → think calcium, vitamin D, protein, strength and risk.",
              "lock": "EXACT"
            },
            {
              "text": "MUSCLE GOALS → think protein, resistance training and recovery.",
              "lock": "EXACT"
            },
            {
              "text": "BRAIN FOG → don't assume a supplement is the answer; look at sleep, mood, medications and possible deficiencies too.",
              "lock": "EXACT"
            },
            {
              "text": "THE INGREDIENT COMES AFTER THE QUESTION.",
              "lock": "EXACT"
            }
          ]
        },
        {
          "id": "S03",
          "type": "cta",
          "headline": {
            "text": "SMARTER QUESTIONS. SMARTER SUPPLEMENTATION.",
            "lock": "EXACT"
          },
          "cta": {
            "text": "VISIT MIROR →\nLink in bio",
            "lock": "EXACT"
          }
        }
      ]
