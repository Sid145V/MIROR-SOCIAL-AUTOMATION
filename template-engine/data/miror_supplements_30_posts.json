        {
          "id": "S01",
          "type": "hook",
          "headline": {
            "text": "SYMPTOM?\n\nDON'T START WITH:\n“WHAT SUPPLEMENT SHOULD I BUY?”\n\nSTART WITH:\n“WHAT COULD BE BEHIND THIS?”",
            "lock": "EXACT"
          }
        },
        {
          "id": "S02",
          "type": "follow-through",
          "headline": {
            "text": "THINK IN PATTERNS:",
            "lock": "EXACT"
