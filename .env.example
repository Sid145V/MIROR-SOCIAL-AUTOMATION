# MIROR Social Automation — Environment Variables Template
# Copy this file to .env for local overrides (never commit .env to version control)

# Server Configuration
PORT=8000
STORAGE_BACKEND=local

# Cloudinary Persistent Image Storage (Required when STORAGE_BACKEND=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# MIROR T01 Renderer Visual Background Color Overrides
MIROR_COLOR_01_NAME=Light Pink
MIROR_COLOR_01_HEX=#F8E3E7

MIROR_COLOR_02_NAME=Soft Purple
MIROR_COLOR_02_HEX=#E7DDF2

MIROR_COLOR_03_NAME=Warm Yellowish White
MIROR_COLOR_03_HEX=#F6F0D8

